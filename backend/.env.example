# Copy to backend/.env (gitignored). The Makefile loads it automatically.

# Postgres from docker-compose.yml (host port 5433 so it doesn't clash with a local 5432).
POSTGRES_PORT=5433
DATABASE_URL=postgres://verdict:verdict@localhost:5433/verdict?sslmode=disable

# HTTP server
HTTP_ADDR=:8080
# Comma-separated CORS allow-list (add the deployed frontend URL here).
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# LLM. Empty key => replay mode: recorded model turns from backend/replay/<caseId>.json
# (tools, validator, gate and audit still run for real against Postgres).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 1 = use recordings even when a key is set
VERDICT_REPLAY=0
# 1 = save successful live runs as recordings (then commit backend/replay/)
VERDICT_RECORD=0
VERDICT_REPLAY_DIR=replay
VERDICT_REPLAY_DELAY_MS=600

# debug | info | warn | error
LOG_LEVEL=info
